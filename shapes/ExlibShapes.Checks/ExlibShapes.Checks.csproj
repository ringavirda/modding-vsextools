<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shape checks over Core's model: no game or imaging dependency. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ExpandedLib.Shapes.Checks</RootNamespace>
    <AssemblyName>ExlibShapes.Checks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExlibShapes.Checks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExlibShapes.Core\ExlibShapes.Core.csproj" />
  </ItemGroup>
</Project>
