<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generators over Core's model: no game or imaging dependency. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ExpandedLib.Shapes.Generators</RootNamespace>
    <AssemblyName>ExlibShapes.Generators</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExlibShapes.Core\ExlibShapes.Core.csproj" />
  </ItemGroup>
</Project>
