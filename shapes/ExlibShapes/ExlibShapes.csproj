<Project Sdk="Microsoft.NET.Sdk">
  <!-- GamePath comes from the repository root's Directory.Build.props. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ExpandedLib.Shapes</RootNamespace>
    <AssemblyName>exlib-shapes</AssemblyName>
    <!-- One tools/<tfm>/<rid>/ folder per RID, each carrying only that platform's libSkiaSharp
         native alongside the shared managed assemblies in tools/<tfm>/any/; `dotnet tool install`
         picks the right one for the installing machine. Not self-contained: the .NET runtime
         itself still comes from whatever SDK the consumer has. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Packed as a .NET global tool (dotnet tool install ExpandedLib.Shapes): a modder gets the
       `exlib-shapes` command with no game licence and no built mod dll - see release.yml, which
       packs and ships this alongside the other tools. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>exlib-shapes</ToolCommandName>
    <PackageId>ExpandedLib.Shapes</PackageId>
    <!-- The tool ships at extools' own version: the "tools" value of this repository's exmod.json,
         the same number a consuming repository pins. -->
    <_ToolsJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\exmod.json'))</_ToolsJson>
    <PackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ToolsJson), '&quot;tools&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</PackageVersion>
    <Authors>fallenstar</Authors>
    <Description>Renders Vintage Story shape files to textured views and animation frames, and multiblock layouts to build schematics, without the game running.</Description>
    <RepositoryUrl>https://github.com/ringavirda/modding-vsextools</RepositoryUrl>
    <PackageTags>vintagestory mod tooling exlib</PackageTags>
    <PackageProjectUrl>https://github.com/ringavirda/modding-vsextools</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Fonts/NotoSans-Regular.ascii.ttf" LogicalName="ExpandedLib.Shapes.Fonts.NotoSans" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shape, ShapeElement, ShapeElementFace, Animation, MultiblockStructure - the game's own
         classes parse the shape and layout JSON exactly the way the client does. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" />
    <!-- protobuf-net backs a [ProtoContract] on some of the game's own model types that Newtonsoft's
         reflection touches while building its contract cache, even though this tool never
         serialises through it - without the reference, deserialising a Shape throws at runtime. -->
    <PackageReference Include="protobuf-net" />
    <!-- protobuf-net's own WCF surrogate depends on these; nothing here compiles against either,
         so both are excluded rather than shipped as three dead SOAP assemblies. -->
    <PackageReference Include="System.ServiceModel.Primitives" ExcludeAssets="all" />
    <PackageReference Include="System.Private.ServiceModel" ExcludeAssets="all" />
    <!-- The software rasteriser's pixel buffer and PNG encoding; the native libSkiaSharp for each
         RuntimeIdentifiers entry above comes along as the package's own native asset, so nothing
         here copies one out of the game install. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lenient asset store, the block/item catalogue, the game install resolver and the mod
         source, shared with the verify tool. -->
    <ProjectReference Include="..\..\assets\ExlibAssets\ExlibAssets.csproj" />
  </ItemGroup>
</Project>
