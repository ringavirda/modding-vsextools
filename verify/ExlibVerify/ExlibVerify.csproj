<Project Sdk="Microsoft.NET.Sdk">
  <!-- GamePath comes from the repository root's Directory.Build.props. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ExpandedLib.Verify</RootNamespace>
    <AssemblyName>exlib-verify</AssemblyName>
  </PropertyGroup>

  <!-- Packed as a .NET global tool (dotnet tool install ExpandedLib.Verify): a JSON-only modder
       gets the `exlib-verify` command with no game licence, no built mod dll, and no xUnit runner -
       see release.yml, which packs and ships this alongside the two libraries. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>exlib-verify</ToolCommandName>
    <PackageId>ExpandedLib.Verify</PackageId>
    <!-- The tool ships at extools' own version: the "tools" value of this repository's exmod.json,
         the same number a consuming repository pins. -->
    <_ToolsJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\exmod.json'))</_ToolsJson>
    <PackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ToolsJson), '&quot;tools&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</PackageVersion>
    <Authors>fallenstar</Authors>
    <Description>Headless JSON-only mod checker for Vintage Story - patch application, recipe and handbook lang coverage, without the game running.</Description>
    <RepositoryUrl>https://github.com/ringavirda/modding-vsextools</RepositoryUrl>
    <PackageTags>vintagestory mod tooling exlib</PackageTags>
    <PackageProjectUrl>https://github.com/ringavirda/modding-vsextools</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lenient asset store, the block/item catalogue, the game install resolver and the mod
         source, shared with the shapes tool. -->
    <ProjectReference Include="..\..\assets\ExlibAssets\ExlibAssets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AssetLocation, WildcardUtil - the same asset-addressing types the game itself uses, so a
         patch target or a recipe code resolves exactly the way it would in game. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own RFC-6902 patch engine, applied against the real target document the same
         way ModJsonPatchLoader (vsessentialsmod) drives it. Stays a compile-only game-path
         Reference like VintagestoryAPI, resolved at runtime by Runner.cs's AssemblyResolve hook:
         nuget.org's Tavis.JsonPatch never passed 0.5.2-beta, and that release is a different,
         incompatible API (namespace Tavis.JsonPatch, not the JsonPatch.Operations/Tavis this code
         calls) - not the library the game ships as 1.0.0, so there is no package to redistribute
         a copy of instead. -->
    <Reference Include="Tavis.JsonPatch">
      <HintPath>$(GamePath)/Lib/Tavis.JsonPatch.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
