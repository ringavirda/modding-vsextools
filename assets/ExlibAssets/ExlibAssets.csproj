<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ExpandedLib.Assets</RootNamespace>
    <AssemblyName>ExlibAssets</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- AssetLocation, WildcardUtil - the same asset-addressing types the game itself uses, so a
         patch target or a recipe code resolves exactly the way it would in game. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
